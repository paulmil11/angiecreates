---
import Layout from './Layout.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getReadingTime } from '../utils/reading-time';

interface Props {
  title: string;
  description?: string;
  date: string;
  slug: string;
  author?: string;
  image?: string;
  categories?: string[];
  content: string;
}

const { title, description, date, slug, author = 'Angie Wang', image, categories = [], content } = Astro.props;
const readingTime = getReadingTime(content);
const siteUrl = 'https://angiecreates.io';
const postUrl = `${siteUrl}/${slug}/`;
const postImage = image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : `${siteUrl}/images/posts/IMG_8674-2-scaled.avif`;
---

<Layout title={title} description={description || title} image={image} slug={slug}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": title,
    "description": description || title,
    "image": postImage,
    "datePublished": date,
    "author": {
      "@type": "Person",
      "name": author,
      "url": siteUrl
    },
    "publisher": {
      "@type": "Person",
      "name": "Angie Wang"
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": postUrl
    },
    "inLanguage": "zh-TW"
  })} />
  <article class="post">
    <div class="post-header container">
      <a href="/blog/" class="back-link">&larr; 所有文章</a>
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <span class="post-author">{author}</span>
        <span class="meta-sep">&middot;</span>
        <time>{date}</time>
        <span class="meta-sep">&middot;</span>
        <span>{readingTime}</span>
      </div>
      {categories.length > 0 && (
        <div class="post-categories">
          {categories.map(cat => (
            <span class="category-tag">{cat}</span>
          ))}
        </div>
      )}
    </div>

    <div class="post-content container">
      <div class="book-callout">
        <span>📖</span>
        <p>我的第一本書《臺灣製造》已經出版了！<a href="https://www.eslite.com/product/10012225642683095330009" target="_blank" rel="noopener">立即購買</a> · <a href="https://mit886.com" target="_blank" rel="noopener">了解更多 →</a></p>
      </div>
      <slot />
    </div>
  </article>

  <div class="container">
    <RelatedPosts currentSlug={slug} currentCategories={categories} />
  </div>
</Layout>

<style>
  .post {
    padding-bottom: 3rem;
  }

  .post-header {
    max-width: var(--content-width);
    padding-top: 2.5rem;
    padding-bottom: 1.5rem;
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .back-link:hover {
    color: var(--color-primary);
  }

  .post-title {
    font-size: clamp(1.6rem, 4vw, 2.25rem);
    line-height: 1.35;
    margin-bottom: 1rem;
  }

  .post-meta {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }

  .meta-sep {
    color: var(--color-border);
  }

  .post-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .category-tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    background: var(--color-bg-alt);
    color: var(--color-text-light);
    padding: 0.2rem 0.6rem;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }

  .post-image {
    max-width: var(--content-width);
    margin-bottom: 2rem;
  }

  .post-image img {
    width: 100%;
    border-radius: 8px;
  }

  /* ── Book callout ────────────────────────────────────── */
  .book-callout {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin-bottom: 2rem;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
  }

  .book-callout span {
    font-size: 1.25rem;
    flex-shrink: 0;
  }

  .book-callout p {
    margin: 0;
    line-height: 1.5;
  }

  .book-callout a {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }

  .book-callout a:hover {
    text-decoration: underline;
  }

  /* ── Post content ────────────────────────────────────── */
  .post-content {
    max-width: var(--content-width);
  }

  .post-content :global(h2) {
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5em;
    line-height: 1.9;
  }

  .post-content :global(img) {
    display: block;
    max-width: 100%;
    margin: 2rem auto;
    border-radius: 6px;
  }

  .post-content :global(figure) {
    margin: 2rem 0;
  }

  .post-content :global(figcaption) {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-align: center;
    margin-top: 0.5rem;
    font-style: italic;
  }

  .post-content :global(blockquote) {
    background: var(--color-bg-alt);
    padding: 1rem 1.5rem;
    border-left: 4px solid var(--color-accent);
    border-radius: 0 6px 6px 0;
    margin: 1.5em 0;
    font-style: italic;
  }

  .post-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5em;
  }

  .post-content :global(li) {
    margin-bottom: 0.5em;
    line-height: 1.8;
  }

  .post-content :global(a) {
    color: var(--color-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    color: var(--color-link-hover);
  }

  /* Video embeds */
  .post-content :global(iframe[src*="youtube"]),
  .post-content :global(iframe[src*="transistor"]) {
    width: 100%;
    max-width: 100%;
    margin: 2rem 0;
    border-radius: 8px;
  }

  .post-content :global(iframe[src*="transistor"]) {
    background: var(--color-bg);
  }

  .post-content :global(iframe[src*="youtube"]) {
    aspect-ratio: 16/9;
    height: auto;
  }

  /* Tables */
  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5em 0;
    font-size: 0.9375rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--color-bg-alt);
    font-weight: 600;
  }

  .post-content :global(tr:hover td) {
    background: var(--color-bg-alt);
  }

  /* Strong/emphasis */
  .post-content :global(strong) {
    color: var(--color-dark);
  }

  .post-content :global(em) {
    font-style: italic;
  }

  @media (max-width: 768px) {
    .post-header {
      padding-top: 1.5rem;
    }

    .post-title {
      font-size: 1.5rem;
    }
  }
</style>
