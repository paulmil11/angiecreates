---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => {
  const cats = data.categories || [];
  const isPodcast = cats.some(c => c.toLowerCase() === 'podcast');
  return isPodcast && (import.meta.env.PROD ? !data.draft : true);
});

const sorted = posts.sort((a, b) =>
  new Date(b.data.rawDate || b.data.date).getTime() - new Date(a.data.rawDate || a.data.date).getTime()
);
---

<Layout title="Angie Creates Podcast" description="Conversations with curious humans on how they seek to become the most alive versions of themselves through creative expression like movement, writing, and art.">
  <section class="podcast-hero section">
    <div class="podcast-hero-inner container">
      <div class="podcast-cover">
        <img src="/images/podcast-cover.jpg" alt="Angie Creates Podcast" />
      </div>
      <div class="podcast-info">
        <h1>Angie Creates Podcast</h1>
        <p class="podcast-tagline">Conversations with curious humans on how they seek to become the most alive versions of themselves through creative expression like movement, writing, and art.</p>
        <p class="podcast-formerly">前身為《好奇槓鈴 Curious Barbell》</p>
        <div class="subscribe-links">
          <a href="https://open.spotify.com/show/775CHBC6MeTytNmFHCwDU0" target="_blank" rel="noopener" class="subscribe-btn spotify">Spotify</a>
          <a href="https://podcasts.apple.com/tw/podcast/angie-creates/id1485860187" target="_blank" rel="noopener" class="subscribe-btn apple">Apple Podcasts</a>
          <a href="https://www.youtube.com/@angieeecreates" target="_blank" rel="noopener" class="subscribe-btn youtube">YouTube</a>
          <a href="https://angiecreates.transistor.fm" target="_blank" rel="noopener" class="subscribe-btn">所有平台</a>
        </div>
      </div>
    </div>
  </section>

  <section class="episodes-section section">
    <div class="container">
      <h2>所有集數 <span class="episode-count">({sorted.length})</span></h2>
      <div class="episodes-list">
        {sorted.map(post => (
          <a href={`/${post.slug}/`} class="episode-card">
            {post.data.image && (
              <img src={post.data.image} alt={post.data.title} class="episode-image" loading="lazy" />
            )}
            <div class="episode-info">
              <h3 class="episode-title">{post.data.title}</h3>
              {post.data.description && (
                <p class="episode-desc">{post.data.description.substring(0, 120)}{post.data.description.length > 120 ? '...' : ''}</p>
              )}
              <time class="episode-date">{post.data.date}</time>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Podcast Hero ─────────────────────────────────── */
  .podcast-hero {
    padding-top: 3rem;
    padding-bottom: 1rem;
  }

  .podcast-hero-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
  }

  .podcast-cover img {
    width: 280px;
    height: 280px;
    border-radius: 16px;
    object-fit: cover;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.12);
  }

  .podcast-info h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin-bottom: 0.75rem;
  }

  .podcast-tagline {
    font-size: 1.0625rem;
    color: var(--color-text-light);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .podcast-formerly {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .subscribe-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .subscribe-btn {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .subscribe-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-primary);
  }

  /* ── Episodes ────────────────────────────────────── */
  .episodes-section h2 {
    margin-bottom: 1.5rem;
  }

  .episode-count {
    font-weight: 400;
    color: var(--color-text-muted);
    font-size: 0.875em;
  }

  .episodes-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .episode-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: #fff;
    transition: all 0.2s ease;
    align-items: center;
  }

  .episode-card:hover {
    border-color: var(--color-accent);
    box-shadow: 0 2px 12px rgba(139, 105, 20, 0.06);
  }

  .episode-image {
    width: 100px;
    height: 100px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .episode-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.4;
    margin-bottom: 0.4rem;
  }

  .episode-desc {
    font-size: 0.875rem;
    color: var(--color-text-light);
    line-height: 1.6;
    margin-bottom: 0.4rem;
  }

  .episode-date {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* ── Responsive ──────────────────────────────────── */
  @media (max-width: 768px) {
    .podcast-hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .podcast-cover img {
      width: 200px;
      height: 200px;
      margin: 0 auto;
    }

    .subscribe-links {
      justify-content: center;
    }

    .episode-card {
      flex-direction: column;
      align-items: flex-start;
    }

    .episode-image {
      width: 100%;
      height: 180px;
    }
  }
</style>
