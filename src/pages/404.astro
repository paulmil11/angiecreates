---
import Layout from '../layouts/Layout.astro';
---

<Layout title="找不到頁面" description="頁面不存在">
  <section class="not-found">
    <div class="container">
      <h1>404</h1>
      <p>找不到頁面</p>
      <div class="not-found-links">
        <a href="/" class="btn btn-primary">回首頁</a>
        <a href="/blog/" class="btn btn-outline">閱讀文章</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 0;
  }

  .not-found h1 {
    font-size: 5rem;
    color: var(--color-accent);
    margin-bottom: 0.5rem;
  }

  .not-found p {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .not-found-links {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .btn-primary {
    background: var(--color-dark);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-outline {
    border: 1.5px solid var(--color-dark);
    color: var(--color-dark);
  }

  .btn-outline:hover {
    background: var(--color-dark);
    color: #fff;
  }
</style>
