---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const recentPosts = posts
  .sort((a, b) => new Date(b.data.rawDate || b.data.date).getTime() - new Date(a.data.rawDate || a.data.date).getTime())
  .slice(0, 6);
---

<Layout>
  <!-- Book Hero -->
  <section class="book-hero section">
    <div class="book-hero-inner container">
      <div class="book-hero-text">
        <h1>《臺灣製造》</h1>
        <p class="book-subtitle">出走，才能回家——從臺中菜市場到紐約常春藤，愛、恐懼與成為的故事</p>
        <p>這是一段關於逃離與回家的旅程。從臺中菜市場的女孩到曼哈頓第五大道，在科技業、健身教練夢、創作與數位遊牧之間穿梭，在恐懼與渴望的拉扯中學會面對自己。</p>
        <p class="book-publish">無路出版 · 2026年3月</p>
        <div class="book-links">
          <a href="https://www.books.com.tw/products/0011045853?sloc=main" target="_blank" rel="noopener" class="btn btn-primary">立即購買</a>
          <a href="https://mit886.com" target="_blank" rel="noopener" class="btn btn-outline">了解更多</a>
        </div>
      </div>
      <div class="book-hero-image">
        <img src="/images/mit-book-cover.png" alt="臺灣製造" />
      </div>
    </div>
  </section>

  <!-- About Angie -->
  <section id="about" class="about-section section">
    <div class="about-inner container">
      <div class="about-image">
        <img src="/images/about-angie.jpg" alt="Angie Wang 安吉" />
      </div>
      <div class="about-text">
        <h2>關於安吉</h2>
        <p>我是 Angie Wang（安吉），台灣出生、美國長大。台大畢業、哥大碩士後進入科技業，但在那裡找不到生命的動力。於是轉職成為健身教練，創辦了台灣最早的健身深度訪談 Podcast 之一，然後和先生保羅開始在西班牙和墨西哥數位遊牧。</p>
        <p>現在住在台灣，專注於寫作和養育孩子。我的第一本書《臺灣製造》講述了我在跨文化身份、冒牌者症候群、和找到自己聲音的旅程。</p>
        <a href="/hello/" class="about-link">完整介紹 &rarr;</a>
        <a href="/english/" class="about-link">English Bio &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Podcast -->
  <section id="podcast" class="podcast-section section">
    <div class="container">
      <h2><a href="/podcast/" style="color:inherit;text-decoration:none;">Angie Creates Podcast</a></h2>
      <p class="section-desc">前身為《好奇槓鈴 Curious Barbell》，專訪健身教練、創業者、醫療專業人士與運動科學研究者，聊訓練專業與人生故事。</p>
      <div class="podcast-links">
        <a href="/podcast/" class="podcast-link">Podcast 頁面</a>
        <a href="https://angiecreates.transistor.fm" target="_blank" rel="noopener" class="podcast-link">所有集數</a>
        <a href="https://open.spotify.com/show/775CHBC6MeTytNmFHCwDU0" target="_blank" rel="noopener" class="podcast-link">Spotify</a>
        <a href="https://podcasts.apple.com/tw/podcast/angie-creates/id1485860187" target="_blank" rel="noopener" class="podcast-link">Apple Podcasts</a>
        <a href="https://www.youtube.com/@angiecreates" target="_blank" rel="noopener" class="podcast-link">YouTube</a>
      </div>
    </div>
  </section>

  <!-- Recent Posts -->
  <section class="recent-section section">
    <div class="container">
      <div class="section-header">
        <h2>最新文章</h2>
        <a href="/blog/" class="see-all">所有文章 &rarr;</a>
      </div>
      <div class="posts-grid">
        {recentPosts.map(post => (
          <a href={`/${post.slug}/`} class="post-card">
            <h3 class="post-card-title">{post.data.title}</h3>
            <span class="post-card-date">{post.data.date}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Substack Subscribe -->
  <section class="substack-section section">
    <div class="container substack-container">
      <h2>訂閱電子報</h2>
      <p class="substack-desc">收到新文章和《臺灣製造》的最新消息。</p>
      <iframe src="https://mit886.substack.com/embed" width="480" height="150" style="border:none; background:transparent;" frameborder="0" scrolling="no"></iframe>
    </div>
  </section>
</Layout>

<style>
  /* ── Book Hero ──────────────────────────────────────── */
  .book-hero {
    padding-top: 3rem;
    padding-bottom: 1rem;
  }

  .book-hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: center;
  }

  .book-hero-image img {
    max-width: 300px;
    transition: transform 0.3s ease;
  }

  .book-hero-image img:hover {
    transform: translateY(-4px);
  }

  .book-hero h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    margin-bottom: 0.5rem;
  }

  .book-subtitle {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .book-publish {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .book-links {
    display: flex;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  /* ── Buttons ─────────────────────────────────────────── */
  .btn {
    display: inline-block;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    font-weight: 500;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    transition: all 0.2s ease;
    cursor: pointer;
    text-align: center;
  }

  .btn-primary {
    background: var(--color-dark);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-outline {
    border: 1.5px solid var(--color-dark);
    color: var(--color-dark);
    background: transparent;
  }

  .btn-outline:hover {
    background: var(--color-dark);
    color: #fff;
  }

  /* ── About ───────────────────────────────────────────── */
  .about-section {
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      var(--color-bg-alt) 10%,
      var(--color-bg-alt) 90%,
      var(--color-bg) 100%
    );
  }

  .about-inner {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 3rem;
    align-items: center;
  }

  .about-image img {
    width: 280px;
    height: 280px;
    border-radius: 12px;
    object-fit: cover;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .about-image img:hover {
    transform: scale(1.02);
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.12);
  }

  /* ── Podcast ─────────────────────────────────────────── */
  .section-desc {
    color: var(--color-text-light);
    max-width: var(--content-width);
    margin-bottom: 1.5rem;
  }

  .podcast-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .podcast-link {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 20px;
    color: var(--color-text);
    transition: all 0.15s ease;
  }

  .podcast-link:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-alt);
    color: var(--color-primary);
  }

  /* ── Recent Posts ────────────────────────────────────── */
  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .see-all {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .see-all:hover {
    color: var(--color-primary);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .post-card {
    display: block;
    padding: 1.25rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    transition: all 0.25s ease;
  }

  .post-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgba(139, 105, 20, 0.08);
  }

  .post-card-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-dark);
    line-height: 1.4;
    margin-bottom: 0.5rem;
  }

  .post-card-date {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  /* ── Substack ──────────────────────────────────────── */
  .substack-section {
    text-align: center;
    padding-top: 3rem;
    padding-bottom: 3rem;
    background: linear-gradient(
      to bottom,
      var(--color-bg) 0%,
      var(--color-bg-alt) 40%,
      var(--color-bg-alt) 100%
    );
  }

  .substack-section h2 {
    margin-bottom: 0.5rem;
  }

  .substack-desc {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .substack-container {
    max-width: 480px;
  }

  .substack-section iframe {
    border: none;
  }

  /* ── Responsive ──────────────────────────────────────── */
  @media (max-width: 768px) {
    .book-hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }

    .book-hero-image {
      order: -1;
    }

    .book-hero-image img {
      max-width: 220px;
      margin: 0 auto;
    }

    .book-links {
      justify-content: center;
    }

    .about-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .about-image img {
      width: 220px;
      height: 220px;
      margin: 0 auto;
    }

    .posts-grid {
      grid-template-columns: 1fr;
    }

    .section-header {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
